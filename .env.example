# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env real no git

# Ambiente: development | production
APP_ENV=development
APP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://cronflow:cronflow_secret@localhost:5432/cronflow?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# Scheduler
SCHEDULER_LOCK_TTL=40s       # TTL do distributed lock (deve ser > SCHEDULER_INTERVAL)
SCHEDULER_INTERVAL=30s       # Frequência do loop do scheduler

# Worker
WORKER_CONCURRENCY=50        # Goroutines paralelas máximas
WORKER_TIMEOUT_DEFAULT=30s   # Timeout padrão por job (máximo permitido)

# Limites de negócio
MAX_JOBS_FREE_PLAN=5
MAX_JOBS_PAID_PLAN=100
LOG_RETENTION_FREE_DAYS=7
LOG_RETENTION_PAID_DAYS=90
